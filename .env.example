# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloud SQL PostgreSQL Configuration (Server-side)
SQL_HOST=127.0.0.1
SQL_DB_NAME=postgres
SQL_USER=postgres
SQL_PASSWORD=
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# Email OTP Providers (Resend + Automatic Gmail SMTP / Brevo Fallback)
MAIL_FROM="Sahara Express <noreply@sahara-express.com>"
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# HMAC Secret for Hashing 6-digit OTP Codes
OTP_HASH_SECRET=
