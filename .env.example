# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloud SQL PostgreSQL Configuration (Server-side)
SQL_HOST=127.0.0.1
SQL_DB_NAME=postgres
SQL_USER=postgres
SQL_PASSWORD=
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# Transactional Email Service Configuration (Server-side for 6-digit OTP)
# Must use a verified custom domain you own (never @gmail.com)
MAIL_FROM="Sahara Express <no-reply@yourdomain.com>"

# Dedicated Transactional Email API Key (Configure Resend OR Brevo in environment variables only)
RESEND_API_KEY=
BREVO_API_KEY=

# HMAC Secret for Hashing 6-digit OTP Codes
OTP_HASH_SECRET=
