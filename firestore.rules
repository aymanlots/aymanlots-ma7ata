rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:@.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User accounts: SECURED
    // allow get: allowed for direct account lookup by ID (phone/email/code)
    // allow list: STRICTLY FALSE - Prevents malicious scrapers from dumping all users and credential hashes
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create, update: if isValidId(userId) && incoming().id is string && incoming().id.size() <= 128;
      allow delete: if isValidId(userId);
    }

    // 6-digit WhatsApp OTP records for password recovery (5-minute expiry & rate limit tracking)
    // allow list: STRICTLY FALSE - Protected from enumeration
    match /password_reset_otps/{phone} {
      allow get: if isValidId(phone);
      allow list: if false;
      allow create, update: if isValidId(phone)
        && incoming().id is string
        && incoming().id.size() <= 64
        && incoming().otp_code is string
        && incoming().otp_code.size() == 6
        && incoming().expires_at_ms is int;
      allow delete: if isValidId(phone);
    }

    // Platform-wide live activity logs (for Platform Owner monitoring)
    match /platform_activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && incoming().id is string && incoming().workspace_id is string;
      allow delete: if isValidId(logId);
    }

    // Partnerships between managers (Cross-company collaboration network)
    match /partnerships/{partnershipId} {
      allow read: if true;
      allow create, update: if isValidId(partnershipId) && incoming().id is string;
      allow delete: if isValidId(partnershipId);

      match /settlements/{settlementId} {
        allow read: if true;
        allow create, update: if isValidId(settlementId) && incoming().id is string;
        allow delete: if isValidId(settlementId);
      }
    }

    // Workspaces and their subcollections
    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create, update: if isValidId(workspaceId) && incoming().id is string && incoming().name is string && incoming().name.size() <= 200;
      allow delete: if isValidId(workspaceId);

      // Stations
      match /stations/{stationId} {
        allow read: if true;
        allow create, update: if isValidId(stationId) && incoming().id is string && incoming().name is string;
        allow delete: if isValidId(stationId);
      }

      // Parcels (including public tracking)
      match /parcels/{parcelId} {
        allow read: if true;
        allow create, update: if isValidId(parcelId) && incoming().id is string && incoming().tracking_code is string;
        allow delete: if isValidId(parcelId);
      }

      // Transactions
      match /transactions/{transactionId} {
        allow read: if true;
        allow create, update: if isValidId(transactionId) && incoming().id is string;
        allow delete: if isValidId(transactionId);
      }

      // Trips
      match /trips/{tripId} {
        allow read: if true;
        allow create, update: if isValidId(tripId) && incoming().id is string;
        allow delete: if isValidId(tripId);
      }

      // Workspace Members (Workers & Managers)
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidId(memberId);
        allow delete: if isValidId(memberId);
      }

      // Per-workspace activity logs
      match /activity_logs/{logId} {
        allow read: if true;
        allow create, update: if isValidId(logId) && incoming().id is string;
        allow delete: if isValidId(logId);
      }
    }
  }
}
