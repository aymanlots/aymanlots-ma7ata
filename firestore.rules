rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:@.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isReasonableDocSize() {
      return incoming().keys().size() <= 60;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User accounts: SECURED
    // allow get: allowed for direct account lookup by ID (phone/email/code)
    // allow list: STRICTLY FALSE - Prevents malicious scrapers from dumping all users and credential hashes
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create, update: if isValidId(userId)
        && isReasonableDocSize()
        && incoming().id is string
        && incoming().id.size() <= 128;
      allow delete: if isValidId(userId);
    }

    // 6-digit OTP records for password recovery (rate limit tracking)
    // allow list: STRICTLY FALSE - Protected from enumeration
    match /password_reset_otps/{phone} {
      allow get: if isValidId(phone);
      allow list: if false;
      allow create, update: if isValidId(phone)
        && isReasonableDocSize()
        && incoming().id is string
        && incoming().id.size() <= 64
        && incoming().otp_code is string
        && incoming().otp_code.size() == 6
        && incoming().expires_at_ms is int;
      allow delete: if isValidId(phone);
    }

    // Platform-wide live activity logs (for Platform Owner monitoring)
    match /platform_activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId)
        && isReasonableDocSize()
        && incoming().id is string
        && incoming().workspace_id is string;
      allow delete: if isValidId(logId);
    }

    // Partnerships between managers (Cross-company collaboration network)
    match /partnerships/{partnershipId} {
      allow read: if true;
      allow create, update: if isValidId(partnershipId)
        && isReasonableDocSize()
        && incoming().id is string
        && incoming().workspace_a_id is string
        && incoming().workspace_b_id is string;
      allow delete: if isValidId(partnershipId);

      match /settlements/{settlementId} {
        allow read: if true;
        allow create, update: if isValidId(settlementId)
          && isReasonableDocSize()
          && incoming().id is string;
        allow delete: if isValidId(settlementId);
      }
    }

    // Workspaces and their subcollections
    match /workspaces/{workspaceId} {
      allow get, list: if true;
      allow create: if isValidId(workspaceId)
        && isReasonableDocSize()
        && incoming().id is string
        && incoming().name is string
        && incoming().name.size() <= 200;
      allow update: if isValidId(workspaceId) && isReasonableDocSize();
      allow delete: if isValidId(workspaceId);

      // Stations
      match /stations/{stationId} {
        allow read: if true;
        allow create, update: if isValidId(stationId)
          && isReasonableDocSize()
          && incoming().id is string
          && incoming().name is string
          && incoming().name.size() <= 150;
        allow delete: if isValidId(stationId);
      }

      // Parcels (including public tracking & isolated partner parcels)
      match /parcels/{parcelId} {
        allow read: if true;
        allow create, update: if isValidId(parcelId)
          && isReasonableDocSize()
          && incoming().id is string
          && (!('tracking_code' in incoming()) || (incoming().tracking_code is string && incoming().tracking_code.size() <= 64));
        allow delete: if isValidId(parcelId);
      }

      // Transactions
      match /transactions/{transactionId} {
        allow read: if true;
        allow create, update: if isValidId(transactionId)
          && isReasonableDocSize()
          && incoming().id is string;
        allow delete: if isValidId(transactionId);
      }

      // Trips
      match /trips/{tripId} {
        allow read: if true;
        allow create, update: if isValidId(tripId)
          && isReasonableDocSize()
          && incoming().id is string;
        allow delete: if isValidId(tripId);
      }

      // Workspace Members (Workers & Managers) — strictly forbid storing passwords in member records
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidId(memberId)
          && isReasonableDocSize()
          && !('password' in incoming());
        allow delete: if isValidId(memberId);
      }

      // Per-workspace activity logs
      match /activity_logs/{logId} {
        allow read: if true;
        allow create, update: if isValidId(logId)
          && isReasonableDocSize()
          && incoming().id is string;
        allow delete: if isValidId(logId);
      }
    }
  }
}
